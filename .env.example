APP_NAME=AppHealth API
APP_VERSION=0.1.0
ENVIRONMENT=development
TIME_ZONE=Asia/Bangkok
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://apphealth:apphealth@localhost:5432/apphealth
SECRET_KEY=development-only-secret-change-before-deployment
JWT_ALGORITHM=HS256
JWT_ISSUER=apphealth-api
JWT_AUDIENCE=apphealth-android
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
GOOGLE_WEB_CLIENT_ID=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=
MAX_IMAGE_SIZE_MB=8
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
